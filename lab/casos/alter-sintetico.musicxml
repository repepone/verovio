<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
   Caso sintético (escrito a mano para este laboratorio, no exportado de Sibelius).
   Reproduce patrones en los que <pitch><alter> es la única fuente fiable de la altura:
   alteraciones que no se arrastran a otra octava, notas ligadas por encima de la barra
   sin <accidental>, y alteraciones sin <accidental> visible.
   Alturas MIDI esperadas (orden del documento), según <step>/<alter>/<octave>:
   c1: 78 65 72 66 | c2: 66 67 70 70 | c3: 66 60 73 60 | c4: 68 67 64
-->
<score-partwise version="4.0">
   <work>
      <work-title>alter-sintetico</work-title>
   </work>
   <identification>
      <encoding>
         <software>escrito a mano</software>
      </encoding>
   </identification>
   <part-list>
      <score-part id="P1">
         <part-name>Voz</part-name>
      </score-part>
   </part-list>
   <part id="P1">
      <measure number="1">
         <attributes>
            <divisions>1</divisions>
            <key>
               <fifths>0</fifths>
            </key>
            <time>
               <beats>4</beats>
               <beat-type>4</beat-type>
            </time>
            <clef>
               <sign>G</sign>
               <line>2</line>
            </clef>
         </attributes>
         <!-- Fa#5 con alteración escrita -->
         <note>
            <pitch>
               <step>F</step>
               <alter>1</alter>
               <octave>5</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
            <accidental>sharp</accidental>
         </note>
         <!-- Fa4 natural: el sostenido de Fa5 no afecta a otra octava -->
         <note>
            <pitch>
               <step>F</step>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
         </note>
         <note>
            <pitch>
               <step>C</step>
               <octave>5</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
         </note>
         <!-- Fa#4 ligada al compás siguiente -->
         <note>
            <pitch>
               <step>F</step>
               <alter>1</alter>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <tie type="start"/>
            <type>quarter</type>
            <accidental>sharp</accidental>
            <notations>
               <tied type="start"/>
            </notations>
         </note>
      </measure>
      <measure number="2">
         <!-- continuación de la ligadura: sin <accidental>, pero alter=1 -->
         <note>
            <pitch>
               <step>F</step>
               <alter>1</alter>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <tie type="stop"/>
            <type>quarter</type>
            <notations>
               <tied type="stop"/>
            </notations>
         </note>
         <note>
            <pitch>
               <step>G</step>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
         </note>
         <note>
            <pitch>
               <step>B</step>
               <alter>-1</alter>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
            <accidental>flat</accidental>
         </note>
         <!-- control: bemol arrastrado en la misma octava, ambas versiones deberían acertar -->
         <note>
            <pitch>
               <step>B</step>
               <alter>-1</alter>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
         </note>
      </measure>
      <measure number="3">
         <attributes>
            <key>
               <fifths>2</fifths>
            </key>
         </attributes>
         <!-- control: Fa# por armadura -->
         <note>
            <pitch>
               <step>F</step>
               <alter>1</alter>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
         </note>
         <note>
            <pitch>
               <step>C</step>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
            <accidental>natural</accidental>
         </note>
         <!-- Do#5 por armadura: el becuadro de Do4 no afecta a otra octava -->
         <note>
            <pitch>
               <step>C</step>
               <alter>1</alter>
               <octave>5</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
         </note>
         <note>
            <pitch>
               <step>C</step>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
         </note>
      </measure>
      <measure number="4">
         <!-- Sol#4 sin <accidental>: solo <alter> lleva la información -->
         <note>
            <pitch>
               <step>G</step>
               <alter>1</alter>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
         </note>
         <note>
            <pitch>
               <step>G</step>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
         </note>
         <note>
            <pitch>
               <step>E</step>
               <octave>4</octave>
            </pitch>
            <duration>1</duration>
            <type>quarter</type>
         </note>
         <note>
            <rest/>
            <duration>1</duration>
            <type>quarter</type>
         </note>
         <barline location="right">
            <bar-style>light-heavy</bar-style>
         </barline>
      </measure>
   </part>
</score-partwise>
